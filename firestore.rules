rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // AVISO: Estas regras são inseguras e servem apenas para desenvolvimento.
    // Elas permitem que qualquer usuário autenticado leia e escreva em qualquer lugar.
    // RESTRINJA ESTAS REGRAS ANTES DE IR PARA PRODUÇÃO.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
